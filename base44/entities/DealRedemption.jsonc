{
  "name": "DealRedemption",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string"
    },
    "deal_title": {
      "type": "string",
      "description": "Denormalized for the member's redemption history"
    },
    "code": {
      "type": "string",
      "description": "Generated redeem code shown to the member"
    }
  },
  "required": [
    "deal_id",
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}