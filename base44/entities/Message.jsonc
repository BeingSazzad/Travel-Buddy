{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "The conversation this message belongs to"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copy of the conversation participants for access control"
    },
    "sender_id": {
      "type": "string",
      "description": "The user id of the sender (denormalized for display)"
    },
    "text": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "content"
      ],
      "default": "text"
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded image URL for image messages"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "destination",
        "trip",
        "cafe",
        "restaurant",
        "hotel",
        "event",
        "deal",
        "meeting"
      ],
      "description": "The kind of Seluna content shared"
    },
    "content_data": {
      "type": "object",
      "description": "Snapshot of the shared content (title, location, image, etc.)"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the recipient has seen this message"
    }
  },
  "required": [
    "conversation_id",
    "participant_ids",
    "type"
  ],
  "rls": {
    "read": {
      "data.participant_ids": "{{user.id}}"
    },
    "create": {
      "data.participant_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "data.participant_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}