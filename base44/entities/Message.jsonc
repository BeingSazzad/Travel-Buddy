{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "The conversation this message belongs to"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copy of the conversation participants for access control"
    },
    "sender_id": {
      "type": "string",
      "description": "The user id of the sender (denormalized for display)"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "participant_ids",
    "text"
  ],
  "rls": {
    "read": {
      "data.participant_ids": "{{user.id}}"
    },
    "create": {
      "data.participant_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}