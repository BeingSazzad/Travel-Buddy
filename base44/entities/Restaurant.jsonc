{
  "name": "Restaurant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "cuisine": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "reviews": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "distance": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "hours": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "menuUrl": {
      "type": "string"
    },
    "reservationUrl": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "description": "vegetarian, vegan, glutenFree, solo, outdoor, romantic, local, reservation booleans"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden"
      ],
      "default": "published"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "city"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}