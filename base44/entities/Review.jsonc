{
  "name": "Review",
  "type": "object",
  "properties": {
    "item_key": {
      "type": "string",
      "description": "Unique content key, e.g. cafe:Caf\u00e9 Norden"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "cafe",
        "restaurant",
        "hotel",
        "destination",
        "activity",
        "deal",
        "event"
      ]
    },
    "item_title": {
      "type": "string",
      "description": "Display name of the reviewed content"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating from 1 to 5"
    },
    "text": {
      "type": "string",
      "description": "The written review"
    },
    "visit_date": {
      "type": "string",
      "format": "date",
      "description": "When the author visited the place"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional photo URLs uploaded by the author"
    },
    "author_name": {
      "type": "string",
      "description": "Author first name (denormalized)"
    },
    "author_avatar": {
      "type": "string",
      "description": "Author profile image URL (denormalized)"
    },
    "helpful_count": {
      "type": "number",
      "default": 0,
      "description": "Cached count of helpful votes"
    }
  },
  "required": [
    "item_key",
    "item_type",
    "item_title",
    "rating",
    "text",
    "author_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}