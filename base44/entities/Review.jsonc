{
  "name": "Review",
  "type": "object",
  "properties": {
    "item_key": {
      "type": "string",
      "description": "Unique content key, e.g. cafe:Caf\u00e9 Norden"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "cafe",
        "restaurant",
        "hotel",
        "destination",
        "deal",
        "event"
      ]
    },
    "item_title": {
      "type": "string",
      "description": "Display name of the reviewed content"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating from 1 to 5"
    },
    "text": {
      "type": "string"
    },
    "author_name": {
      "type": "string",
      "description": "Reviewer display name (denormalized)"
    },
    "author_avatar": {
      "type": "string",
      "description": "Reviewer avatar URL (denormalized)"
    }
  },
  "required": [
    "item_key",
    "item_type",
    "item_title",
    "rating",
    "text",
    "author_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}