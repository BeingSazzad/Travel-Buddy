{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "coffee",
        "brunch",
        "dinner",
        "beach",
        "nightlife",
        "coworking",
        "sightseeing",
        "hiking",
        "shopping",
        "yoga",
        "wellness",
        "wine",
        "networking"
      ]
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string",
      "description": "Human-readable time, e.g. 19:30"
    },
    "location": {
      "type": "string",
      "description": "Venue or meeting spot name"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "attendees_count": {
      "type": "number",
      "default": 0
    },
    "max_attendees": {
      "type": "number",
      "default": 10
    }
  },
  "required": [
    "title",
    "category",
    "date",
    "city",
    "location"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}