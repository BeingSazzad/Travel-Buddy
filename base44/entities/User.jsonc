{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "first_name": {
      "type": "string",
      "description": "The user's first name"
    },
    "last_name": {
      "type": "string",
      "description": "The user's last name"
    },
    "profile_name": {
      "type": "string",
      "description": "Public display name shown on the user's profile"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "The user's date of birth (must be 18+)"
    },
    "current_city": {
      "type": "string",
      "description": "The city where the user currently lives"
    },
    "country": {
      "type": "string",
      "description": "The user's country of residence"
    },
    "nationality": {
      "type": "string",
      "description": "The user's nationality"
    },
    "preferred_language": {
      "type": "string",
      "description": "The user's preferred app language (ISO-639-1 code)"
    },
    "languages_spoken": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Languages the user speaks"
    },
    "biography": {
      "type": "string",
      "description": "A short biography for the user's profile"
    },
    "travel_style": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The user's preferred travel styles"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The user's interests"
    },
    "profile_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of profile photo URLs (minimum 2, maximum 8)"
    },
    "main_photo": {
      "type": "string",
      "description": "URL of the user's main profile photo (must be present in profile_photos)"
    },
    "is_email_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has verified their email address"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the post-subscription profile setup"
    },
    "accepted_terms_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the user accepted the Terms and Conditions"
    },
    "accepted_privacy_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the user accepted the Privacy Policy"
    },
    "accepted_community_guidelines_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the user accepted the Community Guidelines"
    },
    "subscription_status": {
      "type": "string",
      "description": "Current membership subscription status",
      "enum": [
        "none",
        "pending",
        "active",
        "cancelled_active",
        "expired",
        "payment_failed"
      ],
      "default": "none"
    },
    "subscription_plan": {
      "type": "string",
      "description": "The active subscription plan id (monthly/yearly)"
    },
    "subscription_current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the current billing period (drives grace access for cancelled_active)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}