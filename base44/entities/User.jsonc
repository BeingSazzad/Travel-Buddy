{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "first_name": {
      "type": "string",
      "description": "The user's first name"
    },
    "last_name": {
      "type": "string",
      "description": "The user's last name"
    },
    "profile_name": {
      "type": "string",
      "description": "Public display name shown on the user's profile"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "The user's date of birth (must be 18+)"
    },
    "current_city": {
      "type": "string",
      "description": "The city where the user currently lives"
    },
    "country": {
      "type": "string",
      "description": "The user's country of residence"
    },
    "nationality": {
      "type": "string",
      "description": "The user's nationality"
    },
    "preferred_language": {
      "type": "string",
      "description": "The user's preferred app language (ISO-639-1 code)"
    },
    "languages_spoken": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Languages the user speaks"
    },
    "biography": {
      "type": "string",
      "description": "A short biography for the user's profile"
    },
    "travel_style": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The user's preferred travel styles"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The user's interests"
    },
    "profile_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of profile photo URLs (minimum 2, maximum 8)"
    },
    "main_photo": {
      "type": "string",
      "description": "URL of the user's main profile photo (must be present in profile_photos)"
    },
    "location_visibility": {
      "type": "string",
      "description": "How the user's current location is shown to others (never an exact home address)",
      "enum": [
        "exact_city",
        "approximate",
        "hidden"
      ],
      "default": "approximate"
    },
    "show_age": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user's age is displayed on their profile"
    },
    "show_upcoming_trips": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user's upcoming trips are visible to others"
    },
    "allow_match_suggestions": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user receives travel companion match suggestions"
    },
    "allow_event_invitations": {
      "type": "boolean",
      "default": true,
      "description": "Whether other members can send the user event invitations"
    },
    "allow_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle: whether the user receives any app notifications"
    },
    "notif_matches": {
      "type": "boolean",
      "default": true,
      "description": "Notifications for new travel matches"
    },
    "notif_messages": {
      "type": "boolean",
      "default": true,
      "description": "Notifications for new messages"
    },
    "notif_events": {
      "type": "boolean",
      "default": true,
      "description": "Notifications for event invitations, approvals and reminders"
    },
    "notif_trip_suggestions": {
      "type": "boolean",
      "default": true,
      "description": "Notifications for trip reminders and suggestions"
    },
    "notif_destination_activity": {
      "type": "boolean",
      "default": true,
      "description": "Notifications for members travelling to the same destination and destination updates"
    },
    "notif_deals": {
      "type": "boolean",
      "default": true,
      "description": "Notifications for new exclusive deals"
    },
    "notif_recommendations": {
      "type": "boolean",
      "default": true,
      "description": "Notifications for saved place updates and recommendations"
    },
    "notif_marketing": {
      "type": "boolean",
      "default": true,
      "description": "Marketing and promotional messages"
    },
    "notif_safety": {
      "type": "boolean",
      "default": true,
      "description": "Safety and account-critical notices (always on, cannot be disabled)"
    },
    "is_email_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has verified their email address"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the post-subscription profile setup"
    },
    "accepted_terms_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the user accepted the Terms and Conditions"
    },
    "accepted_privacy_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the user accepted the Privacy Policy"
    },
    "accepted_community_guidelines_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the user accepted the Community Guidelines"
    },
    "subscription_status": {
      "type": "string",
      "description": "Current membership subscription status",
      "enum": [
        "none",
        "pending",
        "active",
        "cancelled_active",
        "expired",
        "payment_failed"
      ],
      "default": "none"
    },
    "subscription_plan": {
      "type": "string",
      "description": "The active subscription plan id (monthly/yearly)"
    },
    "subscription_current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the current billing period (drives grace access for cancelled_active)"
    },
    "account_deletion_requested": {
      "type": "boolean",
      "default": false,
      "description": "Set when the user requested account deletion"
    },
    "account_status": {
      "type": "string",
      "description": "Admin-controlled account standing",
      "enum": [
        "active",
        "suspended",
        "banned"
      ],
      "default": "active"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Admin-marked verified profile badge"
    },
    "identity_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only after Veriff confirms the user's identity"
    },
    "age_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only after Veriff confirms the user is 18 or older"
    },
    "verification_status": {
      "type": "string",
      "description": "Current Veriff identity & age verification state",
      "enum": [
        "none",
        "pending",
        "approved",
        "declined",
        "expired",
        "abandoned",
        "resubmission_requested",
        "manual_review_requested",
        "review"
      ],
      "default": "none"
    },
    "verification_provider": {
      "type": "string",
      "description": "The identity verification provider (e.g. Veriff)"
    },
    "verification_session_id": {
      "type": "string",
      "description": "The Veriff session id for the current/last verification attempt"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the user's identity and age were verified"
    },
    "warning_count": {
      "type": "number",
      "default": 0,
      "description": "Number of admin warnings issued"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes (append-only log of notes)"
    },
    "is_test_user": {
      "type": "boolean",
      "default": false,
      "description": "Admin-approved test user \u2014 bypasses payment during testing (TestFlight)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}