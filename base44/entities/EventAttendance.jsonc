{
  "name": "EventAttendance",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "The joined event"
    },
    "user_id": {
      "type": "string",
      "description": "The attending member"
    },
    "host_id": {
      "type": "string",
      "description": "The event host (denormalized) so the host can read attendance"
    },
    "status": {
      "type": "string",
      "enum": [
        "going",
        "pending"
      ],
      "default": "going",
      "description": "Confirmed attendee or pending approval request"
    },
    "event_title": {
      "type": "string",
      "description": "Denormalized for the member's joined-events list"
    },
    "event_image": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "event_id",
    "user_id",
    "host_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.host_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}