{
  "name": "FeaturedContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "link": {
      "type": "string",
      "description": "In-app route to open on tap"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "destination",
        "cafe",
        "restaurant",
        "hotel",
        "event",
        "deal",
        "tip",
        "external"
      ]
    },
    "ref_id": {
      "type": "string",
      "description": "Optional reference id of the linked content"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "image"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}