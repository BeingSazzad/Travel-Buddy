{
  "name": "ReviewVote",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "description": "The review this helpful vote belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "The member who marked the review helpful (denormalized)"
    }
  },
  "required": [
    "review_id",
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}