{
  "name": "Destination",
  "type": "object",
  "properties": {
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "continent": {
      "type": "string"
    },
    "weather": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "object",
      "description": "beach, city, budget, nightlife, wellness, solo booleans"
    },
    "counts": {
      "type": "object",
      "description": "members, cafes, restaurants, hotels, events, deals"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden"
      ],
      "default": "published"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "city"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}